# URL of the backend API.
#
# Local development (Vite dev proxy forwards /api/* → http://localhost:3000):
VITE_API_URL=/api
#
# Vercel production — set this in the Vercel dashboard for the FRONTEND project:
# VITE_API_URL=https://vehicle-inventory-backend.vercel.app/api
#
# The /api rewrite in vercel.json was intentionally removed because Vercel's
# edge CDN strips Set-Cookie headers from proxied responses, which breaks the
# httpOnly refresh-token cookie. Direct browser→backend requests work correctly.

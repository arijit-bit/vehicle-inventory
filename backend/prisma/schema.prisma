generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  EMPLOYEE
  ADMIN
}

enum VehicleImageKey {
  WHITE_RR
  BLUE_BUGATTI
  GREEN_LAMBO
  BLACK_CAR
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(320)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model Vehicle {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  make         String          @db.VarChar(100)
  model        String          @db.VarChar(100)
  year         Int
  category     String          @db.VarChar(100)
  imageKey     VehicleImageKey @map("image_key")
  colorName    String          @map("color_name") @db.VarChar(100)
  colorHex     String          @map("color_hex") @db.Char(7)
  engine       String          @db.VarChar(160)
  transmission Transmission
  fuelType     FuelType        @map("fuel_type")
  details      String          @db.Text
  price        Decimal         @db.Decimal(12, 2)
  quantity     Int             @default(0)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([make, model, year])
  @@index([make])
  @@index([model])
  @@index([category])
  @@index([price])
  @@map("vehicles")
}

model MediaAsset {
  key        String   @id @db.VarChar(64)
  bucket     String   @db.VarChar(100)
  objectPath String   @map("object_path") @db.VarChar(512)
  publicUrl  String   @map("public_url") @db.VarChar(1024)
  altText    String   @map("alt_text") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([bucket, objectPath])
  @@map("media_assets")
}

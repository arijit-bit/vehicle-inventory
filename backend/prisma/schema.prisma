generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  EMPLOYEE
  ADMIN
}

enum VehicleImageKey {
  ARTWORK_PENDING
  WHITE_RR
  BLUE_BUGATTI
  GREEN_LAMBO
  BLACK_CAR
  BLACK_BENTLEY
  GREEN_PORSCHE_911
  BROWN_MAYBACH
  ORANGE_AUDI_R8
  BLACK_RANGE_ROVER
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum OrderStatus {
  RESERVED
  CANCELLED
}

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String         @unique @db.VarChar(320)
  passwordHash   String         @map("password_hash") @db.VarChar(255)
  role           Role           @default(CUSTOMER)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders         Order[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Vehicle {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  make         String          @db.VarChar(100)
  model        String          @db.VarChar(100)
  year         Int
  category     String          @db.VarChar(100)
  imageKey     VehicleImageKey @map("image_key")
  colorName    String          @map("color_name") @db.VarChar(100)
  colorHex     String          @map("color_hex") @db.Char(7)
  engine       String          @db.VarChar(160)
  transmission Transmission
  fuelType     FuelType        @map("fuel_type")
  details      String          @db.Text
  price        Decimal         @db.Decimal(12, 2)
  quantity     Int             @default(0)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders       Order[]

  @@unique([make, model, year])
  @@index([make])
  @@index([model])
  @@index([category])
  @@index([price])
  @@map("vehicles")
}

model Order {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String          @map("user_id") @db.Uuid
  vehicleId           String          @map("vehicle_id") @db.Uuid
  quantity            Int             @default(1)
  unitPrice           Decimal         @map("unit_price") @db.Decimal(12, 2)
  vehicleMake         String          @map("vehicle_make") @db.VarChar(100)
  vehicleModel        String          @map("vehicle_model") @db.VarChar(100)
  vehicleYear         Int             @map("vehicle_year")
  vehicleCategory     String          @map("vehicle_category") @db.VarChar(100)
  vehicleImageKey     VehicleImageKey @map("vehicle_image_key")
  vehicleColorName    String          @map("vehicle_color_name") @db.VarChar(100)
  vehicleColorHex     String          @map("vehicle_color_hex") @db.Char(7)
  vehicleEngine       String          @map("vehicle_engine") @db.VarChar(160)
  vehicleTransmission Transmission    @map("vehicle_transmission")
  vehicleFuelType     FuelType        @map("vehicle_fuel_type")
  vehicleDetails      String          @map("vehicle_details") @db.Text
  status              OrderStatus     @default(RESERVED)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledAt         DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  user                User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle             Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc), id])
  @@index([createdAt(sort: Desc), id])
  @@index([vehicleId])
  @@map("orders")
}

model MediaAsset {
  key        String   @id @db.VarChar(64)
  bucket     String   @db.VarChar(100)
  objectPath String   @map("object_path") @db.VarChar(512)
  publicUrl  String   @map("public_url") @db.VarChar(1024)
  altText    String   @map("alt_text") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([bucket, objectPath])
  @@map("media_assets")
}

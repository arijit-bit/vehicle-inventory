NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Supabase runtime: shared transaction-mode pooler (IPv4, port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Transaction-local safety deadlines for stock mutations.
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Prisma migrations: shared session-mode pooler (IPv4, port 5432).
DIRECT_URL=postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Local Docker alternative:
# DATABASE_URL=postgresql://inventory:inventory@localhost:5432/vehicle_inventory?schema=public
# DIRECT_URL=postgresql://inventory:inventory@localhost:5432/vehicle_inventory?schema=public

# Authentication milestone values (do not commit real values).
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=vehicle-inventory-api
JWT_AUDIENCE=vehicle-inventory-web
BCRYPT_ROUNDS=12
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
